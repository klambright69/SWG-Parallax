	// 10/11/26 klambright - Defines nine city ranks and aliases legacy names to the corresponding renamed ranks; rank progression and cleanup use PLANETARY_CAPITAL as the rank-9 ceiling.
	public static final byte CLIENT = 0;
	public static final byte OUTPOST = 1;
	public static final byte WAYSTATION_ENCAMPMENT = 2;
	public static final byte HOMESTEAD_SECTOR = 3;
	public static final byte GUILD_BOROUGH = 4;
	public static final byte SPACEPORT_TOWNSHIP = 5;
	public static final byte INDUSTRIAL_NEO_CITY = 6;
	public static final byte UPPER_CITY_SPIRE = 7;
	public static final byte HIGH_SECTOR_CITADEL = 8;
	public static final byte PLANETARY_CAPITAL = 9;
	public static final byte VILLAGE = WAYSTATION_ENCAMPMENT;
	public static final byte TOWNSHIP = HOMESTEAD_SECTOR;
	public static final byte CITY = GUILD_BOROUGH;
	public static final byte METROPOLIS = SPACEPORT_TOWNSHIP;
	// continue

	public CityManager(ZoneServer zserv) {
		Logger.setLoggingName("CityManager");
		Logger.setLogging(false);
		Logger.setGlobalLogging(true);

		zoneServer = zserv;

		cities.setNoDuplicateInsertPlan();
		cities.setNullValue(null);
	}

